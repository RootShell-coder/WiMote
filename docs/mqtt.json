{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "WiMote_IR": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        },
        "system": {
          "type": "object",
          "properties": {
            "heap_free": {
              "type": "string"
            },
            "heap_size": {
              "type": "string"
            },
            "cpu_freq_mhz": {
              "type": "string"
            },
            "sdk_version": {
              "type": "string"
            },
            "flash_size": {
              "type": "string"
            },
            "client_id": {
              "type": "string"
            },
            "uptime": {
              "type": "string"
            }
          },
          "required": ["heap_free", "heap_size", "cpu_freq_mhz", "sdk_version", "flash_size", "client_id", "uptime"]
        },
        "wifi": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string"
            },
            "ssid": {
              "type": "string"
            },
            "last_update": {
              "type": "string"
            },
            "ip": {
              "type": "string"
            },
            "rssi": {
              "type": "string"
            },
            "channel": {
              "type": "string"
            }
          },
          "required": ["status", "ssid", "last_update", "ip", "rssi", "channel"]
        },
        "ir": {
          "type": "object",
          "properties": {
            "received": {
              "type": "string"
            },
            "transmitted": {
              "type": "object",
              "properties": {
                "transmitted": {
                  "type": "string"
                },
                "set": {
                  "type": "string"
                },
                "format": {
                  "type": "string"
                }
              },
              "required": ["transmitted", "set", "format"]
            }
          },
          "required": ["received", "transmitted"]
        }
      },
      "required": ["status", "system", "wifi", "ir"]
    }
  },
  "required": ["WiMote_IR"]
}
